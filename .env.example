# Copy to .env (never commit .env).  Used by docker-compose.yml and by `serve`.

# Data feed: TradingMaster's API, read-only.  Use a dedicated read-only login.
SM_DATA_SOURCE=TRADINGMASTER
SM_TM_API_URL=https://api.tradingmaster.online/api/v1
SM_TM_EMAIL=
SM_TM_PASSWORD=

# Required when the server listens on anything but localhost (the Docker image does).
SM_ACCESS_PASSWORD=
# Optional: keep sessions valid across restarts.
SM_SESSION_SECRET=

# Weekday post-close refresh (IST); "off" to disable.
SM_REFRESH_AT=18:40

# Optional Telegram alerts (daily scan, READY setups, trade events).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
